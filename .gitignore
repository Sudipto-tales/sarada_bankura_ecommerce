# Environment
.env

# Composer
/vendor/
composer.phar

# Database files
/database/database.sqlite

# OS files
.DS_Store
Thumbs.db

# IDE/editor files
/.vscode/
/.idea/
*.sublime-workspace
*.sublime-project

# Logs and runtime files
/logs/
*.log
*.cache

# Storage (keep the directories, ignore their contents)
/storage/logs/*
/storage/cache/*
/storage/uploads/*
/storage/imports/*
!/storage/**/.gitkeep

# Build and temporary files
*.tmp
*.temp
*.bak
*.swp
*.zip

# Tailwind standalone CLI binary (42MB — re-download via bin/build-css.sh)
/tools/tailwind/tailwindcss
/node_modules/
/public/assets/uploads/products/*
!/public/assets/uploads/products/.gitkeep
# Media library (Stage 1): public files and private files (payment proofs, documents)
/public/assets/uploads/media/*
!/public/assets/uploads/media/.gitkeep
/storage/media/*
!/storage/media/.gitkeep

# Ignore generated test reports
/phpunit.xml
/phpunit.xml.dist

# Ignore agent files
/agent/**