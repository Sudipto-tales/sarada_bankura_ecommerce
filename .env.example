# Application
APP_NAME="Maa Sarada Marble & Stone"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
# Indian time only (see docs/roadmap.md). MySQL sessions are set to the same offset on connect.
APP_TIMEZONE=Asia/Kolkata

# Logging: daily | single
LOG_CHANNEL=daily

# Database: sqlite for local dev, mysql in production.
DB_TYPE=sqlite
DB_DATABASE=database/database.sqlite
# Production (MySQL 8 / MariaDB 10.6+), uncomment and fill:
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maa_sarada
# DB_USERNAME=maa_sarada
# DB_PASSWORD=''
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Mail (SMTP): real credentials go in .env only, never commit them.
# Keep passwords in single quotes: unquoted, a # starts a comment and cuts the value short.
# Gmail needs an App Password (Google account > Security > App passwords), not the login password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=''
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Default admin (Owner) created by `php vayu admin:install` — email and/or 10-digit mobile.
# The random first password is printed once in the console; it must be changed on first login.
ADMIN_EMAIL=
ADMIN_PHONE=

# Business identity (config/business.php, read with business('key')): invoices, emails, footer.
BUSINESS_NAME="Maa Sarada Marble & Stone"
BUSINESS_ADDRESS_LINE1=
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=Bankura
BUSINESS_STATE="West Bengal"
BUSINESS_STATE_CODE=19
BUSINESS_PINCODE=
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_EMAIL=
BUSINESS_GSTIN=
BUSINESS_PAN=
BUSINESS_LOGO=assets/image/logo.webp
BUSINESS_PRICES_INCLUDE_TAX=false
BUSINESS_GST_RATE=18
BUSINESS_HSN_DEFAULT=6802

# WhatsApp (Meta Cloud API) — dormant until ENABLED=true and the 5 required values are set.
# See docs/whatsapp.md §1. Use a System User token (the 24 h temporary token expires).
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_LANG=en
WHATSAPP_TEST_NUMBER=

# Real-time WebSocket server (php vayu websocket) — needs workerman/workerman
WS_HOST=0.0.0.0
WS_PORT=8080
WS_WORKERS=1
WS_HEARTBEAT=55
# Auto-broadcast events implementing Vayu\Realtime\BroadcastsEvents
WS_AUTO_BROADCAST=true
WS_ALLOW_CLIENT_PUBLISH=false
# Comma-separated Origin allow-list for the handshake (empty = allow all)
WS_ALLOWED_ORIGINS=
# Internal HTTP->WS broadcast bridge. Keep on loopback.
WS_BROADCAST_HOST=127.0.0.1
WS_BROADCAST_PORT=2207

# Set true to bridge legacy array-based routes (app/view.php, api/gateway.php)
VAYU_LEGACY_ROUTES=false
