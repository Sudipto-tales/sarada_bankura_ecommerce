# Production .env template for Hostinger (maasaradamarbleandsanitation.com).
# The real file lives ONLY on the server at  <DEPLOY_PATH>/shared/.env  (chmod 600).
# Never commit it and never put these values in GitHub. Everything not listed here
# falls back to the defaults documented in .env.example.

APP_NAME="Maa Sarada Marble & Stone"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://maasaradamarbleandsanitation.com
# APP_KEY: generate on the server with  php vayu key:generate
APP_KEY=
APP_TIMEZONE=Asia/Kolkata
LOG_CHANNEL=daily

# The app runs on the same server as the database, so the host is localhost
# (srv1751.hstgr.io is only for connecting from outside).
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u402700136_sarada_db
DB_USERNAME=u402700136_sarada_marble
# Keep passwords in single quotes: unquoted, a # starts a comment and cuts the value short.
DB_PASSWORD=''
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Hostinger mailbox. From address MUST equal MAIL_USERNAME or Hostinger rejects the mail.
# Port 465 + ssl; if blocked use 587 + tls. Password in single quotes (see DB_PASSWORD).
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@maasaradamarbleandsanitation.com
MAIL_PASSWORD=''
MAIL_FROM_ADDRESS=no-reply@maasaradamarbleandsanitation.com
MAIL_FROM_NAME="Maa Sarada Marble & Stone"

# Used once by `php vayu admin:install` on the first deploy.
ADMIN_EMAIL=
ADMIN_PHONE=

# Replies to no-reply mails go here (a real inbox you read).
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS_LINE1=
BUSINESS_PINCODE=
BUSINESS_GSTIN=

# Keep false (coming-soon page) until you have checked the live site as admin.
STOREFRONT_ENABLED=false
STOREFRONT_LAUNCH_AT=2026-11-25T00:00:00
STOREFRONT_CACHE_TTL=600

WHATSAPP_ENABLED=false
